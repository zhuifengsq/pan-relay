# ==============================================================================
# .env 文件示例（请勿直接使用！）
# 使用步骤：
# 1. 复制此文件，重命名为 .env
# 2. 将占位符（your_xxx_here）替换为真实值
# 3. .env 文件已在 .gitignore 中，不会提交到 Git
# ==============================================================================

# 应用密钥与会话安全 (生产环境请务必修改为随机复杂字符串)
SECRET_KEY = your_secret_key_here

# SQLite 数据库配置（可选，留空则默认保存在 data/pan_relay.db，无需安装任何数据库软件）
# SQLITE_DB_PATH = data/pan_relay.db

# 生产启动方式（python serve.py，waitress WSGI）：监听地址 / 端口 / 工作线程数
# HOST = 0.0.0.0
# PORT = 5004
# WAITRESS_THREADS = 8

# 管理员鉴权 Cookie 是否强制 Secure（HTTPS 部署建议开启；内网纯 HTTP 保持默认）
# COOKIE_SECURE = 1

# 上游搜索共享线程池大小与单次搜索全局截止时间（秒，0 表示不启用）
# SEARCH_UPSTREAM_MAX_WORKERS = 32
# SEARCH_UPSTREAM_DEADLINE_SECONDS = 0

# 系统日志保留天数（内置每日 03:30 的日志清理任务）
# LOG_RETENTION_DAYS = 30

# 站内资源库按标题搜索的单次最大返回条数（默认 500）
# RESOURCE_SEARCH_LIMIT = 500

# 网盘转存成功后的等待秒数（默认 0.5，批量入库可设为 0 提速）
# PAN_STORE_SETTLE_SECONDS = 0.5

# 是否启动内置定时任务（默认 1；多实例部署时只在主实例开启，其余设为 0）
# SCHEDULER_ENABLED = 1

# ==============================================================================
# 安全加固相关（第二批次新增）
# ==============================================================================

# 反向代理 / 负载均衡地址白名单（逗号分隔 IP 或 CIDR）。
# 仅当请求来自这些地址时，才信任 X-Forwarded-For / X-Real-IP 等转发头；
# 未配置时一律使用 TCP 直连地址，防止客户端伪造 IP 绕过限流与黑名单。
# 例：TRUSTED_PROXIES = 127.0.0.1,10.0.0.0/8
# TRUSTED_PROXIES =

# 分页与搜索返回条数的硬上限（防止 page_size/limit 传超大或负数导致全表导出）
# MAX_PAGE_SIZE = 100
# MAX_SEARCH_LIMIT = 100

# 管理员登录限速：窗口内失败次数 / 窗口秒数 / 锁定时长秒数
# LOGIN_MAX_ATTEMPTS = 5
# LOGIN_WINDOW_SECONDS = 300
# LOGIN_LOCKOUT_SECONDS = 900

# SSE 流式搜索最大并发连接数（每条连接占用一个 waitress 线程）
# SSE_MAX_CONCURRENT = 64

# 慢请求日志阈值（毫秒），超过则记录 WARNING 日志（含 request_id）
# SLOW_REQUEST_MS = 800

# 插件专用线程池大小与源级熔断开关（连续失败 3 次冷却 60 秒，默认开启，失败探测指数退避到 300 秒上限）
# SEARCH_PLUGIN_MAX_WORKERS = 8
# SEARCH_CIRCUIT_BREAKER_ENABLED = 1
# SEARCH_CIRCUIT_BREAKER_COOLDOWN_SECONDS = 60
# SEARCH_CIRCUIT_BREAKER_MAX_COOLDOWN_SECONDS = 300

# 跨进程转存幂等锁目录（默认 <项目>/data/locks；多容器部署时需挂载共享卷）
# PAN_TRANSFER_LOCK_DIR = /app/data/locks

# 管理员初始化账号密码（首次启动自动创建，默认: admin / admin123）
ADMIN_USERNAME = admin
ADMIN_PASSWORD = admin123

# ==============================================================================
# 业务功能与网盘配置说明：
# 所有网盘凭证 (Cookie / Token)、前台搜索页开关、API 搜索范围与鉴权 Key、
# 搜索源插件及 Telegram 频道等，均统一在管理后台可视化界面中配置管理，
# 支持热更新与免重启即时生效！
# 默认后台地址：http://localhost:5004/admin（可在“系统配置 → 后台入口路径”修改）
# ==============================================================================